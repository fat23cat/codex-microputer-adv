+
+static void nimble_hid_report_write(uint8_t report_type, uint8_t report_id,
+                                    const uint8_t *data, uint16_t length,
+                                    void *arg)
+{
+    esp_ble_hidd_dev_t *dev = (esp_ble_hidd_dev_t *)arg;
+    uint8_t mode = ESP_HID_PROTOCOL_MODE_REPORT;
+    hidd_le_report_item_t *report = find_report(report_id, report_type, &mode);
+    if (dev == NULL || report == NULL || data == NULL || length == 0) {
+        return;
+    }
+
+    const size_t event_size = sizeof(esp_hidd_event_data_t) + length;
+    esp_hidd_event_data_t *event = (esp_hidd_event_data_t *)calloc(1, event_size);
+    if (event == NULL) {
+        ESP_LOGE(TAG, "output report event allocation failed");
+        return;
+    }
+    uint8_t *payload = (uint8_t *)event + sizeof(esp_hidd_event_data_t);
+    memcpy(payload, data, length);
+
+    if (report_type == ESP_HID_REPORT_TYPE_OUTPUT) {
+        event->output.dev = dev->dev;
+        event->output.report_id = report_id;
+        event->output.usage = report->usage;
+        event->output.length = length;
+        /* esp_event copies event_size bytes but cannot relocate pointers. */
+        event->output.data = NULL;
+        event->output.map_index = report->map_index;
+        esp_event_post_to(dev->event_loop_handle, ESP_HIDD_EVENTS,
+                          ESP_HIDD_OUTPUT_EVENT, event, event_size,
+                          portMAX_DELAY);
+    } else if (report_type == ESP_HID_REPORT_TYPE_FEATURE) {
+        event->feature.dev = dev->dev;
+        event->feature.report_id = report_id;
+        event->feature.usage = report->usage;
+        event->feature.length = length;
+        event->feature.data = NULL; /* payload follows event inline */
+        event->feature.map_index = report->map_index;
+        esp_event_post_to(dev->event_loop_handle, ESP_HIDD_EVENTS,
+                          ESP_HIDD_FEATURE_EVENT, event, event_size,
+                          portMAX_DELAY);
+    }
+    free(event);
+}
